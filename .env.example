# ---- LLM ----
# Provider: groq (recommended) or gemini
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (used for embeddings by default, and optionally as LLM)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ---- Embeddings (RAG) ----
# gemini (uses GEMINI_API_KEY) or hash (no external calls, lower quality)
EMBED_PROVIDER=gemini
EMBED_MODEL=models/gemini-embedding-001

# ---- Firebase ----
FIREBASE_API_KEY=your_firebase_web_api_key
# Base64-encoded service account JSON
SERVICE_ACCOUNT_JSON_B64=your_base64_service_account

# ---- Sessions ----
SESSION_TTL_DAYS=30

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- Dodo Payments (Merchant of Record) ----
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_PRO=pdt_xxx
DODO_PRODUCT_BUSINESS=pdt_xxx
