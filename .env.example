# ---- LLM ----
# Provider: groq (recommended) or gemini
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (used for embeddings by default, and optionally as LLM)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ---- Embeddings (RAG) ----
# gemini (uses GEMINI_API_KEY) or hash (no external calls, lower quality)
EMBED_PROVIDER=gemini
EMBED_MODEL=models/gemini-embedding-001

# ---- Firebase ----
FIREBASE_API_KEY=your_firebase_web_api_key
# Base64-encoded service account JSON
SERVICE_ACCOUNT_JSON_B64=your_base64_service_account

# ---- Sessions ----
SESSION_TTL_DAYS=30

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
